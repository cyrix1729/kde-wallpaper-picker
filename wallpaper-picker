def current_wallpaper():
    """Image of the first desktop using the plain image wallpaper plugin."""
    try:
        group = ""
        for line in APPLETSRC.read_text().splitlines():
            if line.startswith("["):
                group = line
            elif line.startswith("Image=") and group.endswith("[Wallpaper][org.kde.image][General]"):
                out = line[len("Image="):]
                return QUrl(out).toLocalFile() if out.startswith("file:") else out
    except OSError:
        pass
    return ""


class Backend(QObject):
    changed = Signal()

    def __init__(self):
        super().__init__()
        self._revision = 0
        self._status = ""
        self._cache_mtime = 0
        self.cache = load_mood_cache()
        self.job = QProcess(self)
        self.job.finished.connect(self._job_finished)
        self.poll = QTimer(self, interval=1000)
        self.poll.timeout.connect(self._reload_cache)
        self._start_analysis()

    def _start_analysis(self):
        todo = [p for p in wallpapers() if self.cache.get(p, {}).get("stamp") != stamp(p)]
        if todo:
            self._set_status(f"Analysing {len(todo)} new wallpaper{'s' * (len(todo) > 1)}…")
        self.job.start(str(SCRIPT), [str(FOLDER), "--analyse"])
        self.poll.start()

    def _job_finished(self):
        self.poll.stop()
        self._reload_cache(force=True)
        if self._status.startswith("Analysing"):
            self._set_status("")

    def _reload_cache(self, force=False):
        try:
            mtime = MOOD_CACHE.stat().st_mtime_ns
        except OSError:
            return
        if force or mtime != self._cache_mtime:
            self._cache_mtime = mtime
            self.cache = load_mood_cache()
            self._bump()

    def _bump(self):
        self._revision += 1
        self.changed.emit()

    def _set_status(self, text):
        self._status = text
        self._bump()

    @Property(int, notify=changed)
    def revision(self):
        return self._revision

    @Property(str, notify=changed)
    def status(self):
        return self._status

    @Property(str, notify=changed)
    def mode(self):
        return current_mode()

    @Slot()
    def toggleMode(self):
        if current_mode() == "colour" and not smart_installed():
            self._set_status("Smart mode isn't installed: run install.sh --smart")
            return
        themes = load_themes()
        themes["mode"] = "colour" if current_mode() == "smart" else "smart"
        save_themes(themes)
        self._set_status("")

    @Slot(str, result=str)
    def label(self, path):
        mood, how = mood_for(path, cache=self.cache, allow_analysis=False)
        if mood is None:
            return "analysing…"
        suffix = {"set": " (set)", "colour": " (colour)" if current_mode() == "smart" else ""}.get(how, "")
        return f"{mood}{suffix} · {station_name(music_source(path, mood=mood))}"

    @Slot(str)
    def cycleMood(self, path):
        themes = load_themes()
        entry = themes.get(Path(path).name, {})
        options = ["auto"] + list(mood_table())
        current = entry.get("mood", "auto")
        nxt = options[(options.index(current) + 1) % len(options)] if current in options else "auto"
        if nxt == "auto":
            entry.pop("mood", None)
        else:
            entry["mood"] = nxt
        if entry:
            themes[Path(path).name] = entry
        else:
            themes.pop(Path(path).name, None)
        save_themes(themes)
        self._bump()

    @Property(str, constant=True)
    def folderPath(self):
        return str(FOLDER)

    @Property(QUrl, constant=True)
    def folderUrl(self):
        return QUrl.fromLocalFile(str(FOLDER))

    @Property(str, constant=True)
    def currentWallpaper(self):
        return current_wallpaper()

    @Slot(str)
    def apply(self, path):
        subprocess.Popen(["plasma-apply-wallpaperimage", path],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        set_lockscreen(path)
        theme = theme_for(path)
        set_accent(theme.get("accent", "auto"), path)
        # Music may need a moment of analysis, so do it after the picker has closed.
        subprocess.Popen([str(SCRIPT), "--set-music", path], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def load_themes():
    if not THEMES.exists():
        THEMES.parent.mkdir(parents=True, exist_ok=True)
        THEMES.write_text(json.dumps(DEFAULT_THEMES, indent=2) + "\n")
    try:
        return json.loads(THEMES.read_text())
    except (OSError, ValueError):
        return DEFAULT_THEMES


def save_themes(themes):
    tmp = THEMES.with_suffix(".tmp")
    tmp.write_text(json.dumps(themes, indent=2) + "\n")
    tmp.replace(THEMES)


FOLDER = Path(sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-")
              else load_themes().get("folder", DEFAULT_THEMES["folder"])).expanduser()


def wallpapers():
    return sorted(str(f) for f in FOLDER.iterdir() if f.suffix.lower() in IMAGE_EXT) if FOLDER.is_dir() else []


def current_mode():
    return "smart" if load_themes().get("mode") == "smart" else "colour"


def smart_installed():
    return SMART_PYTHON.exists() and CLASSIFY.exists()


def mood_table():
    """{mood: {"music": ..., "prompts": [...]}}; a user entry may be just a music string."""
    table = {m: dict(v) for m, v in DEFAULT_THEMES["moods"].items()}
    for mood, value in load_themes().get("moods", {}).items():
        if isinstance(value, str):
            value = {"music": value}
        table[mood] = {**table.get(mood, {"music": SOMA % "dronezone", "prompts": []}), **value}
    return table


def stamp(path):
    try:
        st = os.stat(path)
    except OSError:
        return ""
    return f"{st.st_mtime_ns}:{st.st_size}"


def load_mood_cache():
    try:
        return json.loads(MOOD_CACHE.read_text())
    except (OSError, ValueError):
        return {}


def save_mood_cache(cache):
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = MOOD_CACHE.with_suffix(f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(cache))
    tmp.replace(MOOD_CACHE)


def analyse(paths):
    """Work out and cache colour (and, if installed, smart) moods for these images."""
    cache = load_mood_cache()
    for path in paths:
        entry = cache.get(path, {})
        if entry.get("stamp") != stamp(path):
            cache[path] = {"stamp": stamp(path), "colour": wallpaper_mood(path)}
    cache = {p: v for p, v in cache.items() if os.path.isfile(p)}
    save_mood_cache(cache)
    if not smart_installed():
        return cache
    prompts = {m: v.get("prompts", []) for m, v in mood_table().items()}
    prompt_key = hashlib.sha1(json.dumps(prompts, sort_keys=True).encode()).hexdigest()[:12]
    todo = [p for p in paths if cache[p].get("smart", {}).get("key") != prompt_key]
    if not todo:
        return cache
    job = {"images": todo, "moods": prompts, "cache": str(CACHE / "clip-embeddings.json"),
           "models": str(CACHE / "models")}
    try:
        out = subprocess.run([str(SMART_PYTHON), "-I", str(CLASSIFY)], input=json.dumps(job),
                             capture_output=True, text=True, timeout=600).stdout
        results = json.loads(out or "{}")
    except (OSError, subprocess.SubprocessError, ValueError):
        return cache
    cache = load_mood_cache()  # another run may have written meanwhile
    for path, result in results.items():
        if path in cache:
            cache[path]["smart"] = {**result, "key": prompt_key}
    save_mood_cache(cache)
    return cache


def mood_for(path, theme=None, cache=None, allow_analysis=True):
    """(mood, how) where how is "set", "smart" or "colour"; (None, None) if not analysed yet."""
    theme = theme or theme_for(path)
    if theme.get("mood"):
        return theme["mood"], "set"
    if cache is None:
        cache = load_mood_cache()
    entry = cache.get(path, {})
    if entry.get("stamp") != stamp(path):
        if not allow_analysis:
            return None, None
        entry = analyse([path]).get(path, {})
    smart = entry.get("smart")
    if current_mode() == "smart" and smart and smart["conf"] >= SMART_MIN_CONF:
        return smart["mood"], "smart"
    return entry.get("colour") or wallpaper_mood(path), "colour"


def station_name(source):
    match = re.search(r"somafm\.com/([a-z0-9]+?)-\d+-mp3", source)
    if match:
        return SOMA_NAMES.get(match.group(1), match.group(1))
    return "your music" if os.path.isdir(source) else Path(source).name


def theme_for(path):
    themes = load_themes()
    return {**DEFAULT_THEMES["default"], **themes.get("default", {}), **themes.get(Path(path).name, {})}


def wallpaper_pixels(path):
    """HSV (0..1, hue -1 when grey) of a 64x64 thumbnail, or [] if the image can't be read."""
    img = QImage(path)
    if img.isNull():
        return []
    img = img.scaled(64, 64, Qt.IgnoreAspectRatio, Qt.SmoothTransformation)
    return [QColor(img.pixel(x, y)).getHsvF()[:3] for y in range(img.height()) for x in range(img.width())]


def dominant_colour(pixels):
    """(hue, sat, value) of the most prominent vivid colour, or None if there isn't one."""
    buckets = {}
    for h, s, v in pixels:
        if h < 0 or s < 0.25 or v < 0.25:
            continue
        b = buckets.setdefault(int(h * 24) % 24, [0.0, 0.0, 0.0, 0.0])
        w = s * v
        b[0] += w; b[1] += h * w; b[2] += s * w; b[3] += v * w
    if not buckets:
        return None
    weight, h, s, v = max(buckets.values())
    return h / weight, s / weight, v / weight


def wallpaper_mood(path):
    pixels = wallpaper_pixels(path)
    if not pixels:
        return "muted"
    n = len(pixels)
    brightness = sum(v for _, _, v in pixels) / n
    saturation = sum(s for _, s, _ in pixels) / n
    neon = sum(1 for h, s, v in pixels if s > 0.55 and v > 0.55 and (0.45 < h < 0.56 or 0.72 < h < 0.95)) / n
    lights = sum(1 for _, _, v in pixels if v > 0.8) / n
    shadows = sum(1 for _, _, v in pixels if v < 0.25) / n
    dominant = dominant_colour(pixels)
    hue = dominant[0] * 360 if dominant else None
    if shadows > 0.3 and lights > 0.05 and saturation >= 0.15:
        return "city"  # lots of black broken up by bright lights
    if brightness < 0.35:
        if neon > 0.03 or lights > 0.06:
            return "city"
        if hue is not None and 60 <= hue < 170:
            return "nature"  # night forest
        return "space" if hue is not None and 190 <= hue < 340 else "dark"
    if saturation < 0.15 or hue is None:
        return "muted"
    if brightness > 0.65 and saturation < 0.35 or 290 <= hue < 340:
        return "dreamy"
    if hue < 50 or hue >= 340:
        return "warm"
    return "nature" if hue < 160 else "cool"


def wallpaper_accent(path):
    """Most prominent vivid colour in the image, nudged to be readable as an accent."""
    dominant = dominant_colour(wallpaper_pixels(path))
    if not dominant:
        return None
    h, s, v = dominant
    r, g, b = colorsys.hsv_to_rgb(h, min(max(s, 0.55), 0.85), min(max(v, 0.75), 0.95))
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def set_accent(accent, path):
    colour = wallpaper_accent(path) if accent == "auto" else accent
    if colour:
        subprocess.run(["plasma-apply-colorscheme", "--accent-color", colour],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def has_audio(folder):
    return folder.is_dir() and any(f.suffix.lower() in AUDIO_EXT for f in folder.iterdir())


def music_source(path, theme=None, mood=None):
    theme = theme or theme_for(path)
    if "music" in theme:
        return os.path.expanduser(theme["music"])
    if has_audio(MUSIC_DIR / Path(path).stem):
        return str(MUSIC_DIR / Path(path).stem)
    mood = mood or mood_for(path, theme)[0]
    if has_audio(MOOD_DIR / mood):
        return str(MOOD_DIR / mood)
    moods = mood_table()
    return os.path.expanduser(moods.get(mood, moods["muted"])["music"])


def set_music(source):
    """Restart the music only if it changed and music is already playing."""
    try:
        if MUSIC_STATE.read_text() == source:
            return
    except OSError:
        pass
    if subprocess.run(["pkill", "-f", "^/usr/bin/vlc -I dummy --control dbus"]).returncode != 0:
        return  # music was stopped by the user; leave it off
    subprocess.Popen([str(BOOT_MUSIC), "--now", source], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def main_screen(app):
    """KDE's primary monitor (priority 1). Qt's primaryScreen() ignores KDE's choice on Wayland."""
    try:
        out = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=3).stdout
        outputs = [o for o in json.loads(out)["outputs"] if o.get("enabled")]
        name = min(outputs, key=lambda o: o.get("priority") or 99)["name"]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError):
        name = ""
    return next((s for s in app.screens() if s.name() == name), app.primaryScreen())


def set_lockscreen(path):
    """Use the same image on the lock screen."""
    subprocess.run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Greeter",
                    "--group", "Wallpaper", "--group", "org.kde.image", "--group", "General",
                    "--key", "Image", QUrl.fromLocalFile(path).toString()],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    if "--music-source" in sys.argv:
        print(music_source(current_wallpaper()))
        return
    if "--set-music" in sys.argv:
        set_music(music_source(sys.argv[sys.argv.index("--set-music") + 1]))
        return
    if "--analyse" in sys.argv:
        analyse(wallpapers())
        return
    if "--moods" in sys.argv:
        cache = analyse(wallpapers())
        print(f"mode: {current_mode()}" + ("" if smart_installed() else " (smart not installed)"))
        for path in wallpapers():
            mood, how = mood_for(path, cache=cache)
            smart = cache.get(path, {}).get("smart")
            conf = f"{smart['conf']:.2f}" if smart and how != "set" else "    "
            print(f"{mood:8} {how:6} {conf}  {Path(path).name}")
        return
    FOLDER.mkdir(parents=True, exist_ok=True)
    app = QGuiApplication(sys.argv)
    app.setDesktopFileName("wallpaper-picker")
    engine = QQmlApplicationEngine()
    backend = Backend()
    engine.rootContext().setContextProperty("backend", backend)
    engine.load(QUrl.fromLocalFile(str(QML)))
    if not engine.rootObjects():
        sys.exit(1)
    window = engine.rootObjects()[0]
    screen = main_screen(app)
    window.setScreen(screen)
    window.setGeometry(screen.geometry())
    window.showFullScreen()
    window.requestActivate()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
