MUSIC_STATE = CACHE / "music-source"
MOOD_CACHE = CACHE / "moods.json"
SCRIPT = Path(__file__).resolve()
BOOT_MUSIC = Path.home() / ".local/bin/boot-music.sh"
SMART_PYTHON = Path.home() / ".local/share/wallpaper-picker-smart/venv/bin/python"
CLASSIFY = SCRIPT.parent / "smart/classify.py"
SMART_MIN_CONF = 0.5  # below this, smart mode falls back to the colour mood
IMAGE_EXT = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".avif", ".jxl"}
AUDIO_EXT = {".mp3", ".flac", ".ogg", ".opus", ".m4a", ".wav"}
