#!/usr/bin/python3 -I
"""Cover-flow wallpaper picker for KDE Plasma (UI in ~/.local/share/wallpaper-picker/picker.qml).

Lists images in the configured folder (default ~/Pictures/Wallpapers) and applies the chosen one to every screen,
along with a matching accent colour and music (see ~/.config/wallpaper-picker/themes.json).

The music follows the wallpaper's mood. In "colour" mode the mood comes from the image's colours
(warm -> lofi, neon night -> city, ...); in "smart" mode CLIP matches the image against each mood's
descriptions (smart/classify.py, installed with install.sh --smart), falling back to colours when unsure.

`wallpaper-picker --moods` lists the mood picked for every wallpaper;
`wallpaper-picker --music-source` prints the music source for the current wallpaper;
`wallpaper-picker --analyse` analyses new wallpapers (the picker runs this in the background).
"""
import colorsys
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QObject, Property, QProcess, Qt, QTimer, QUrl, Signal, Slot
from PySide6.QtGui import QColor, QGuiApplication, QImage
from PySide6.QtQml import QQmlApplicationEngine

QML = Path.home() / ".local/share/wallpaper-picker/picker.qml"
APPLETSRC = Path.home() / ".config/plasma-org.kde.plasma.desktop-appletsrc"
THEMES = Path.home() / ".config/wallpaper-picker/themes.json"
MUSIC_DIR = Path.home() / "Music/Wallpapers"
MOOD_DIR = Path.home() / "Music/Moods"
